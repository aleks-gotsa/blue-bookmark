// Generates packages/core/src/data/confusables.ts from Unicode's confusables.txt (UTS #39). No dependencies.
// Usage: node scripts/gen-confusables.mts <path/to/confusables.txt>   (Node >= 22.6, native type stripping)
// Keeps only the entries whose source is not ASCII and whose target is one ASCII letter or digit: the lookalikes that
// let a word pass for Latin. The source file is not committed; its version and sha256 go into the generated header.
import { createHash } from "node:crypto";
import { readFileSync, writeFileSync } from "node:fs";

const input = process.argv[2];
if (!input) throw new Error("usage: node scripts/gen-confusables.mts <confusables.txt>");
const raw = readFileSync(input, "utf8");
const version = /^# Version: (\S+)/m.exec(raw)?.[1];
if (!version) throw new Error("no '# Version:' line: not a confusables.txt");
const sha256 = createHash("sha256").update(raw).digest("hex");

const pairs: [number, string][] = [];
for (const line of raw.split("\n")) {
  const m = /^([0-9A-F]{4,6})\s*;\s*([0-9A-F ]+?)\s*;\s*MA\b/.exec(line);
  if (!m) continue;
  const src = parseInt(m[1], 16);
  const tgt = m[2].split(" ").map((h) => parseInt(h, 16));
  if (src < 0x80 || tgt.length !== 1 || !/^[A-Za-z0-9]$/.test(String.fromCharCode(tgt[0]))) continue;
  pairs.push([src, String.fromCharCode(tgt[0])]);
}
pairs.sort((a, b) => a[0] - b[0]);

// one entry per line as [code point, ASCII]; code points in hex so the file holds no raw lookalike characters
const body = pairs.map(([cp, a]) => `  [0x${cp.toString(16).toUpperCase()}, "${a}"],`).join("\n");
const out = `// GENERATED by scripts/gen-confusables.mts. Do not edit by hand.
// Source: Unicode confusables.txt (UTS #39 Unicode Security Mechanisms), version ${version}, sha256 ${sha256}.
// Subset: ${pairs.length} non-ASCII code points whose confusable target is one ASCII letter or digit.
// Data © Unicode, Inc., used under the Unicode License V3 (see THIRD_PARTY_NOTICES.md).
export const CONFUSABLES_VERSION = "${version}";
export const CONFUSABLE_TO_ASCII: ReadonlyMap<number, string> = new Map<number, string>([
${body}
]);
`;
writeFileSync(new URL("../packages/core/src/data/confusables.ts", import.meta.url), out);
console.log(`confusables ${version}: ${pairs.length} entries`);
